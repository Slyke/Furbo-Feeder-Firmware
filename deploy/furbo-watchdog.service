# Start from cec_init.sh in place of its unmanaged watchdog launch.
[Unit]
Description=Furbo factory media and radio recovery monitor
After=cec_image.service apps-launcher.service
[Service]
Type=simple
ExecStart=/bin/sh /usr/local/bin/ProcWatchdog.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
